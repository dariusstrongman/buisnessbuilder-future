      "environment": [
        {"name": "APP_VERSION", "value": "provider-connection-oauth-v1"},
        {"name": "ENVIRONMENT", "value": "staging"},
        {"name": "AWS_REGION", "value": "us-east-1"},
        {"name": "DB_HOST", "value": "businessbuilder-staging-postgres.c6dky0uekbz0.us-east-1.rds.amazonaws.com"},
        {"name": "DB_PORT", "value": "5432"},
        {"name": "DB_NAME", "value": "businessbuilder"},
        {"name": "DB_SCHEMA", "value": "bb_provider_oauth_v1_r3"},
        {"name": "DB_SSLMODE", "value": "require"},
        {"name": "JOB_QUEUE_URL", "value": "https://sqs.us-east-1.amazonaws.com/199949321335/businessbuilder-staging-jobs"},
        {"name": "ARTIFACT_BUCKET", "value": "businessbuilder-staging-artifacts-199949321335-us-east-1"},
