        {"name": "OAUTH_PROOF_ID", "value": "provider_connection_oauth_v1"}
      ],
      "secrets": [
        {"name": "DB_USER", "valueFrom": "arn:aws:secretsmanager:us-east-1:199949321335:secret:rds!db-9f2897e1-1327-4129-bc98-0c2dc9cbee87-fKvB2A:username::"},
        {"name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:199949321335:secret:rds!db-9f2897e1-1327-4129-bc98-0c2dc9cbee87-fKvB2A:password::"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/businessbuilder-staging",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "provider-oauth-worker"
        }
      }
    }
  ]
}
