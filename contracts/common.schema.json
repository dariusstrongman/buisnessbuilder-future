{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.businessbuilder.local/v1/common.schema.json","title":"Business Builder Common Types","$defs":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9_:-]{2,127}$"},
    "timestamp":{"type":"string","format":"date-time"},
    "digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "money":{"type":"object","additionalProperties":false,"required":["currency","minor_units"],"properties":{"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"minor_units":{"type":"integer"}}},
    "ref":{"type":"object","additionalProperties":false,"required":["type","id"],"properties":{"type":{"type":"string","minLength":1},"id":{"$ref":"#/$defs/id"},"version":{"type":"integer","minimum":1}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["source_type","captured_at","actor_ref"],"properties":{"source_type":{"enum":["founder","authoritative_source","provider","system","inference","import"]},"source_ref":{"type":"string","maxLength":2048},"captured_at":{"$ref":"#/$defs/timestamp"},"actor_ref":{"$ref":"#/$defs/ref"},"content_digest":{"$ref":"#/$defs/digest"},"confidence":{"type":"number","minimum":0,"maximum":1},"notes":{"type":"string","maxLength":2000}}},
    "permission":{"type":"string","pattern":"^[a-z][a-z0-9_.:-]{2,127}$"},
    "error":{"type":"object","additionalProperties":false,"required":["code","retryable","safe_message"],"properties":{"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,63}$"},"retryable":{"type":"boolean"},"safe_message":{"type":"string","maxLength":500},"evidence_ref":{"$ref":"#/$defs/ref"}}}
  }
}
