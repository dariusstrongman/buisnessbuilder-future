{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.businessbuilder.local/v1/capability.schema.json","title":"Capability v1","type":"object","additionalProperties":false,
  "required":["schema_version","capability_id","kind","provider","contract_versions","status","permissions_required","human_controls","features"],
  "properties":{"schema_version":{"const":"capability.v1"},"capability_id":{"$ref":"common.schema.json#/$defs/id"},"kind":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{2,127}$"},"provider":{"type":"string","minLength":1,"maxLength":100},"contract_versions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"status":{"enum":["available","partial","restricted","parked","unavailable","unknown"]},"permissions_required":{"type":"array","uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/permission"}},"human_controls":{"type":"array","uniqueItems":true,"items":{"enum":["approval","founder_action","external_authority","spend_authorization"]}},"features":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{2,127}$"}},"limits":{"type":"object"},"health_evidence_ref":{"$ref":"common.schema.json#/$defs/ref"}}
}
