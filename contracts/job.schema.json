{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.businessbuilder.local/v1/job.schema.json","title":"Job v1","type":"object","additionalProperties":false,
  "required":["schema_version","job_id","company_id","capability_id","objective","status","idempotency_key","input_artifact_refs","required_approval_refs","budget_ref","created_at","updated_at","version"],
