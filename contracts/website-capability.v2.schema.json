{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.businessbuilder.local/v2/website-capability.schema.json",
  "title": "Website Capability v2",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/progress"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "request_id",
        "company_id",
        "job_id",
        "correlation_id",
        "idempotency_key",
        "brief_artifact_ref",
        "brief_digest",
        "approved_claims",
        "prohibited_claims",
        "asset_refs",
        "requirements",
        "budget_ref",
        "approval_policy"
      ],
      "properties": {
        "schema_version": {
          "const": "website.capability.request.v2"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "company_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "job_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        },
        "brief_artifact_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "brief_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "approved_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "prohibited_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "asset_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "required_routes",
            "responsive",
            "accessible",
            "delivery"
          ],
          "properties": {
            "mode": {
              "enum": [
                "new",
                "redesign"
              ]
            },
            "required_routes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^/[a-z0-9/_-]*$"
              }
            },
            "responsive": {
              "const": true
            },
            "accessible": {
              "const": true
            },
            "delivery": {
              "const": "static_package"
            }
          }
        },
        "budget_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "approval_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction",
            "delivery",
            "publish"
          ],
          "properties": {
            "direction": {
              "const": "founder_required"
            },
            "delivery": {
              "const": "founder_required"
            },
            "publish": {
              "const": "outside_capability"
            }
          }
        },
        "tenant_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "request_id",
        "company_id",
        "job_id",
        "provider_job_ref",
        "status",
        "artifact_refs",
        "verification_refs",
        "spend",
        "completed_at"
      ],
      "properties": {
        "schema_version": {
          "const": "website.capability.result.v2"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "company_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "job_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "provider_job_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "enum": [
            "accepted",
            "package_ready",
            "failed",
            "cancelled"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          }
        },
        "verification_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          }
        },
        "spend": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "failure": {
          "$ref": "common.schema.json#/$defs/error"
        },
        "completed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "tenant_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "event_id",
        "company_id",
        "job_id",
        "provider_job_ref",
        "milestone",
        "occurred_at",
        "sequence"
      ],
      "properties": {
        "schema_version": {
          "const": "website.capability.progress.v2"
        },
        "event_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "company_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "job_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "provider_job_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "milestone": {
          "enum": [
            "accepted",
            "researching",
            "concepts_ready",
            "founder_choice_required",
            "building",
            "reviewing",
            "revision_required",
            "delivery_approval_required",
            "package_ready",
            "failed",
            "cancelled"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          }
        },
        "approval_ref": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    }
  }
}
