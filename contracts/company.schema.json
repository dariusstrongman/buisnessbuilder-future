{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.businessbuilder.local/v1/company.schema.json","title":"Company v1","type":"object","additionalProperties":false,
  "required":["schema_version","company_id","display_name","archetype","jurisdiction","owner_refs","lifecycle","readiness","provenance","created_at","updated_at","version"],
  "properties":{"schema_version":{"const":"company.v1"},"company_id":{"$ref":"common.schema.json#/$defs/id"},"display_name":{"type":"string","minLength":1,"maxLength":200},"legal_name":{"type":["string","null"],"maxLength":200},"archetype":{"enum":["local_fixed_service","mobile_service","professional_service","appointment_business"]},"jurisdiction":{"type":"object","additionalProperties":false,"required":["country","region"],"properties":{"country":{"type":"string","pattern":"^[A-Z]{2}$"},"region":{"type":"string","minLength":1,"maxLength":100},"locality":{"type":["string","null"],"maxLength":120}}},"owner_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/ref"}},"lifecycle":{"enum":["draft","challenged","approved","assembly","ready","fully_set","operating","paused","archived"]},"readiness":{"enum":["not_ready","ready","fully_set"]},"permissions":{"type":"array","uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/permission"}},"provenance":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/provenance"}},"created_at":{"$ref":"common.schema.json#/$defs/timestamp"},"updated_at":{"$ref":"common.schema.json#/$defs/timestamp"},"version":{"type":"integer","minimum":1}}
