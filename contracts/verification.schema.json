{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.businessbuilder.local/v1/verification.schema.json","title":"Verification v1","type":"object","additionalProperties":false,
  "required":["schema_version","verification_id","company_id","target_ref","state","method","evidence_refs","verified_scope","retest_on","criticality","updated_at","version"],
