{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.businessbuilder.local/v2/founder-action.schema.json",
  "title": "FounderAction v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "founder_action_id",
    "company_id",
    "action_type",
    "title",
    "reason",
    "instructions",
    "risk",
    "irreversible",
    "state",
    "required_evidence_kinds",
    "created_at",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": "founder-action.v2"
    },
    "founder_action_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "company_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "action_type": {
      "enum": [
        "identity",
        "sign",
        "file",
        "purchase",
        "accept_terms",
        "open_account",
        "connect_account",
        "approve_claim",
        "choose_insurance",
        "attest_license",
        "authorize_spend",
        "hire",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "irreversible": {
      "type": "boolean"
    },
    "state": {
      "enum": [
        "required",
        "in_progress",
        "submitted",
        "verified",
        "declined",
        "expired",
        "waived_noncritical"
      ]
    },
    "required_evidence_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "blocks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "due_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/id"
    }
  }
}
